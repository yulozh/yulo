# Yulo OS default settings
# Applied system-wide via dconf

[org/gnome/desktop/interface]
gtk-theme='Yulo'
icon-theme='Yulo'
color-scheme='prefer-light'
cursor-theme='Yaru'
font-name='Cantarell 11'
document-font-name='Cantarell 11'
monospace-font-name='Monospace 11'
titlebar-font='Cantarell Bold 11'
enable-animations=true
gtk-enable-animations=true
show-battery-percentage=true

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/yulo/wallpaper_4k_poster.png'
picture-uri-dark='file:///usr/share/backgrounds/yulo/wallpaper_4k_poster_dark.png'
picture-options='zoom'
primary-color='#000000'
secondary-color='#000000'
color-shading-type='solid'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/yulo/wallpaper_4k_poster.png'
picture-options='zoom'
lock-enabled=true
lock-delay=300

[org/gnome/desktop/wm/preferences]
theme='Yulo'
button-layout=':minimize,maximize,close'
resize-with-right-button=true
mouse-button-modifier='<Super>'

[org/gnome/mutter]
dynamic-workspaces=true
workspaces-only-on-primary=false
auto-maximize=true
edge-tiling=true
experimental-features=['scale-monitor-framebuffer','autoclose-xwayland']

[org/gnome/shell]
enabled-extensions=['yulo-shell@yulo.dev','ubuntu-appindicators@ubuntu.com']
favorite-apps=['org.gnome.Nautilus.desktop','chromium-browser.desktop','org.gnome.Terminal.desktop','org.gnome.Settings.desktop','org.gnome.TextEditor.desktop','org.gnome.Calendar.desktop','org.gnome.Software.desktop']
welcome-dialog-last-shown-version=''
disable-user-extensions=false
show-clock-seconds=true
show-weekdate=true

[org/gnome/shell/extensions/yulo-shell]
dark-mode=false
panel-position='bottom'
panel-height=48
show-start-button=true
show-clock=true
show-input-indicator=true
show-power-button=true
window-close-animation=true
window-open-animation=true

[org/gnome/desktop/applications]
calendar-show-weekdate=true

[org/gnome/settings-daemon/plugins/color]
night-light-enabled=true
night-light-schedule-automatic=true
night-light-temperature=4000

[org/gnome/settings-daemon/plugins/media-keys]
logout=['<Control><Alt>Delete']
screensaver=['<Super>l']

[org/gnome/desktop/peripherals/touchpad]
tap-to-click=true
two-finger-scrolling-enabled=true
natural-scroll=true

[org/gnome/desktop/peripherals/keyboard]
delay=500
repeat-interval=30
numlock-state=true

[org/gnome/libinput]
accel-profile='adaptive'

[org/gnome/desktop/privacy]
report-technical-problems=false
send-software-usage-stats=false
old-files-age=30
remember-recent-files=true
recent-files-max-age=7
remove-old-temp-files=true
remove-old-trash-files=true

[org/gnome/software]
allow-updates=true
download-updates-notify=true
enable-firmware-updates=true
first-run=false
installed-only=false
show-only-free-apps=false
use-ubuntu-pro-attach=true

[org/gtk/settings/file-chooser]
sort-directories-first=true
show-hidden=false
show-size-column=true
show-type-column=true
window-size=(1000,600)

[org/gnome/nautilus/preferences]
default-folder-viewer='icon-view'
search-filter-time-type='last_modified'
search-view='icon-view'
show-image-thumbnails='always'
thumbnail-limit=4096
show-delete-permanent=false
mouse-back-button=true
mouse-forward-button=true
use-experimental-views=false
click-policy='double'
show-create-link=true
