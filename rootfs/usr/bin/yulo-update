#!/bin/bash
# yulo OS - 系统更新工具
# 简单易用的系统更新，小白也能看懂

set -e

echo "========================================="
echo "       yulo OS 系统更新"
echo "========================================="
echo ""

# 检查是否为 root
if [ "$EUID" -ne 0 ]; then
    echo "需要管理员权限，正在请求 sudo..."
    exec sudo "$0" "$@"
fi

echo "[1/4] 更新软件源..."
apt-get update -qq
echo "  ✓ 软件源已更新"

echo ""
echo "[2/4] 检查可用更新..."
UPGRADES=$(apt list --upgradable 2>/dev/null | grep -c "upgradable" || echo "0")
echo "  可用更新: $UPGRADES 个"

if [ "$UPGRADES" -eq 0 ]; then
    echo ""
    echo "系统已是最新版本！"
    echo "========================================="
    exit 0
fi

echo ""
echo "[3/4] 下载并安装更新..."
apt-get upgrade -y -qq
echo "  ✓ 更新已安装"

echo ""
echo "[4/4] 清理旧文件..."
apt-get autoremove -y -qq
apt-get clean
echo "  ✓ 清理完成"

echo ""
echo "========================================="
echo "  系统更新完成！"
echo "  已安装 $UPGRADES 个更新"
echo "========================================="
echo ""
echo "是否需要重启？(y/N)"
read -r REBOOT
if [[ "$REBOOT" =~ ^[Yy]$ ]]; then
    echo "正在重启..."
    reboot
fi

exit 0
